#!/bin/sh
set -eu
export LC_ALL=C

INTERFACE="${TATER_SETUP_INTERFACE:-wlan0}"
ADDRESS="${TATER_SETUP_ADDRESS:-192.168.4.1}"
COUNTRY="${TATER_SETUP_WIFI_COUNTRY:-US}"
WAIT_SECONDS="${TATER_SETUP_WAIT_SECONDS:-45}"
CONFIG=/etc/tater-sat1-standalone/config.toml
PORTAL=/opt/tater-sat1/venv/bin/tater-sat1-provisioning
RUNTIME_DIR=/run/tater-sat1-setup
HOSTAPD_CONFIG="${RUNTIME_DIR}/hostapd.conf"
HOSTAPD_PID="${RUNTIME_DIR}/hostapd.pid"
DNSMASQ_PID="${RUNTIME_DIR}/dnsmasq.pid"
SSID_FILE="${RUNTIME_DIR}/ssid"

pid_is_running() {
  pidfile="$1"
  [ -s "${pidfile}" ] && kill -0 "$(cat "${pidfile}")" 2>/dev/null
}

stop_pid() {
  pidfile="$1"
  if pid_is_running "${pidfile}"; then
    kill "$(cat "${pidfile}")" 2>/dev/null || true
  fi
  rm -f "${pidfile}"
}

wifi_is_connected() {
  nmcli -t -f TYPE,STATE device status 2>/dev/null | grep -q '^wifi:connected$'
}

has_wifi_profile() {
  nmcli -t -f TYPE connection show 2>/dev/null | grep -Eq '^(802-11-wireless|wifi)$'
}

wait_for_wifi() {
  elapsed=0
  while [ "${elapsed}" -lt "${WAIT_SECONDS}" ]; do
    wifi_is_connected && return 0
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

setup_ssid() {
  mac="$(cat "/sys/class/net/${INTERFACE}/address" 2>/dev/null | tr -d ':' | tr '[:lower:]' '[:upper:]' || true)"
  suffix="$(printf '%s' "${mac}" | tail -c 6)"
  [ "${#suffix}" -eq 6 ] || suffix=000000
  printf 'Tater-SAT1-Setup-%s\n' "${suffix}"
}

write_hostapd_config() {
  ssid="$1"
  cat > "${HOSTAPD_CONFIG}" <<EOF
interface=${INTERFACE}
driver=nl80211
ssid=${ssid}
country_code=${COUNTRY}
ieee80211d=1
hw_mode=g
channel=6
auth_algs=1
wpa=0
ignore_broadcast_ssid=0
EOF
  chmod 600 "${HOSTAPD_CONFIG}"
}

stop_services() {
  stop_pid "${DNSMASQ_PID}"
  stop_pid "${HOSTAPD_PID}"
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device set "${INTERFACE}" managed yes >/dev/null 2>&1 || true
    nmcli radio wifi on >/dev/null 2>&1 || true
  fi
  rm -rf "${RUNTIME_DIR}"
}

start_services() {
  mkdir -p "${RUNTIME_DIR}"
  chmod 700 "${RUNTIME_DIR}"
  stop_pid "${DNSMASQ_PID}"
  stop_pid "${HOSTAPD_PID}"

  ssid="$(setup_ssid)"
  printf '%s\n' "${ssid}" > "${SSID_FILE}"
  write_hostapd_config "${ssid}"

  rfkill unblock wifi || true
  nmcli radio wifi on || true
  nmcli device disconnect "${INTERFACE}" >/dev/null 2>&1 || true
  nmcli device set "${INTERFACE}" managed no
  ip link set "${INTERFACE}" down
  ip address flush dev "${INTERFACE}"
  ip link set "${INTERFACE}" up
  ip address add "${ADDRESS}/24" dev "${INTERFACE}"

  hostapd -B -P "${HOSTAPD_PID}" "${HOSTAPD_CONFIG}"
  dnsmasq \
    --keep-in-foreground \
    --conf-file=/dev/null \
    --pid-file="${DNSMASQ_PID}" \
    --interface="${INTERFACE}" \
    --bind-dynamic \
    --dhcp-range=192.168.4.20,192.168.4.100,255.255.255.0,12h \
    --dhcp-option=3,"${ADDRESS}" \
    --dhcp-option=6,"${ADDRESS}" \
    --address=/#/"${ADDRESS}" \
    --no-resolv \
    --no-hosts \
    >/tmp/tater-sat1-dnsmasq.log 2>&1 &

  trap 'stop_services' EXIT
  trap 'exit 0' INT TERM
  echo "Tater setup hotspot ready: ${ssid} at http://${ADDRESS}/"
  "${PORTAL}" --config "${CONFIG}" --bind "${ADDRESS}" --port 80
}

ensure_setup() {
  wifi_is_connected && return 0
  if has_wifi_profile && wait_for_wifi; then
    return 0
  fi
  start_services
}

case "${1:-}" in
  ensure) ensure_setup ;;
  start) start_services ;;
  stop) stop_services ;;
  status)
    if pid_is_running "${HOSTAPD_PID}"; then
      echo "active: $(cat "${SSID_FILE}" 2>/dev/null || echo unknown)"
    elif wifi_is_connected; then
      echo connected
    else
      echo inactive
      exit 1
    fi
    ;;
  *)
    echo "Usage: $0 {ensure|start|stop|status}" >&2
    exit 2
    ;;
esac
