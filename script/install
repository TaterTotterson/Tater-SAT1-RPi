#!/bin/sh
set -eu

PROJECT_DIR="$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)"
MANIFEST_PATH="${PROJECT_DIR}/upstreams.toml"

DRY_RUN=0
ENABLE_SERVICES=1
INSTALL_APT=1
BUNDLED_SOURCES=0
DEFER_INIT=0
FLAVOR="${TATER_SAT1_FLAVOR:-standalone}"

usage() {
  printf '%s\n' "Usage: script/install [--flavor standalone|satellite] [--dry-run] [--no-enable] [--skip-apt] [--bundled-sources] [--defer-init]"
  printf '%s\n' ""
  printf '%s\n' "Installs the pinned SAT1 voice runtime, optionally with a local Tater server."
  printf '%s\n' "--dry-run is safe to use on a development host."
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --no-enable) ENABLE_SERVICES=0 ;;
    --skip-apt) INSTALL_APT=0 ;;
    --bundled-sources) BUNDLED_SOURCES=1 ;;
    --defer-init) DEFER_INIT=1 ;;
    --flavor)
      [ "$#" -ge 2 ] || { printf '%s\n' "--flavor requires a value" >&2; exit 2; }
      FLAVOR="$2"
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

case "${FLAVOR}" in
  standalone|satellite) ;;
  *) printf 'Unknown image flavor: %s\n' "${FLAVOR}" >&2; exit 2 ;;
esac

run() {
  if [ "${DRY_RUN}" = "1" ]; then
    printf '  +'
    for argument in "$@"; do
      printf ' %s' "${argument}"
    done
    printf '\n'
    return 0
  fi
  "$@"
}

section() {
  printf '\n%s\n' "$1"
}

if command -v python3.11 >/dev/null 2>&1; then
  PYTHON_BIN="python3.11"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  printf '%s\n' "python3.11 or python3 is required" >&2
  exit 1
fi

manifest_value() {
  "${PYTHON_BIN}" -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb"))[sys.argv[2]][sys.argv[3]])' "${MANIFEST_PATH}" "$1" "$2"
}

TATER_URL="$(manifest_value tater url)"
TATER_REVISION="$(manifest_value tater reference_revision)"
SATELLITE_URL="$(manifest_value linux_satellite url)"
SATELLITE_REVISION="$(manifest_value linux_satellite reference_revision)"

TATER_ROOT="${TATER_INSTALL_TATER_ROOT:-/opt/tater}"
TATER_APP_DIR="${TATER_ROOT}/app"
TATER_VENV_DIR="${TATER_ROOT}/venv"
APPLIANCE_ROOT="${TATER_INSTALL_APPLIANCE_ROOT:-/opt/tater-sat1}"
SATELLITE_APP_DIR="${APPLIANCE_ROOT}/linux-satellite"
APPLIANCE_VENV_DIR="${APPLIANCE_ROOT}/venv"
STATE_DIR="${TATER_INSTALL_STATE_DIR:-/var/lib/tater-sat1-standalone}"
CONFIG_DIR="${TATER_INSTALL_CONFIG_DIR:-/etc/tater-sat1-standalone}"
SYSTEMD_DIR="${TATER_INSTALL_SYSTEMD_DIR:-/etc/systemd/system}"
CONFIG_PATH="${CONFIG_DIR}/config.toml"
SERVICE_USER="${TATER_INSTALL_USER:-tater}"

if [ "${DRY_RUN}" != "1" ]; then
  [ "$(uname -s)" = "Linux" ] || { printf '%s\n' "This installer targets Linux; use --dry-run elsewhere." >&2; exit 1; }
  [ "$(id -u)" = "0" ] || { printf '%s\n' "Run the installer as root (sudo script/install)." >&2; exit 1; }
fi

clone_pinned() {
  source_url="$1"
  revision="$2"
  destination="$3"

  if [ "${DRY_RUN}" = "1" ]; then
    run git clone "${source_url}" "${destination}"
    run git -C "${destination}" checkout --detach "${revision}"
    return 0
  fi

  if [ -d "${destination}/.git" ]; then
    if [ -n "$(git -C "${destination}" status --porcelain)" ]; then
      printf 'Refusing to update modified checkout: %s\n' "${destination}" >&2
      exit 1
    fi
    git -C "${destination}" fetch origin "${revision}"
  elif [ -e "${destination}" ]; then
    printf 'Install destination exists but is not a Git checkout: %s\n' "${destination}" >&2
    exit 1
  else
    git clone "${source_url}" "${destination}"
  fi
  git -C "${destination}" checkout --detach "${revision}"
}

section "System packages"
if [ "${INSTALL_APT}" = "1" ]; then
  run apt-get update
  run apt-get install --yes --no-install-recommends \
    alsa-utils \
    build-essential \
    ca-certificates \
    ffmpeg \
    git \
    i2c-tools \
    libasound2-dev \
    libmpv-dev \
    mpv \
    portaudio19-dev \
    pulseaudio \
    pulseaudio-utils \
    python3 \
    python3-dev \
    python3-venv
  if [ "${FLAVOR}" = "standalone" ]; then
    run apt-get install --yes --no-install-recommends redis-server
  fi
else
  printf '%s\n' "  skipping apt packages"
fi

section "Service account and directories"
if [ "${DRY_RUN}" = "1" ] || ! id "${SERVICE_USER}" >/dev/null 2>&1; then
  run useradd --system --user-group --home-dir "${STATE_DIR}" --shell /usr/sbin/nologin "${SERVICE_USER}"
fi
run install -d -m 0755 "${APPLIANCE_ROOT}" "${CONFIG_DIR}" "${SYSTEMD_DIR}"
if [ "${FLAVOR}" = "standalone" ]; then
  run install -d -m 0755 "${TATER_ROOT}"
fi
run install -d -m 0700 -o "${SERVICE_USER}" -g "${SERVICE_USER}" "${STATE_DIR}"

if [ "${DRY_RUN}" != "1" ]; then
  for group_name in audio gpio i2c spi; do
    if getent group "${group_name}" >/dev/null 2>&1; then
      usermod -a -G "${group_name}" "${SERVICE_USER}"
    fi
  done
else
  printf '%s\n' "  + usermod -a -G <available audio/gpio/i2c/spi groups> ${SERVICE_USER}"
fi

section "Pinned application sources"
if [ "${BUNDLED_SOURCES}" = "1" ]; then
  [ -f "${SATELLITE_APP_DIR}/pyproject.toml" ] || { printf 'Bundled Linux Satellite source is missing: %s\n' "${SATELLITE_APP_DIR}" >&2; exit 1; }
  if [ "${FLAVOR}" = "standalone" ]; then
    [ -f "${TATER_APP_DIR}/setup_tater.sh" ] || { printf 'Bundled Tater source is missing: %s\n' "${TATER_APP_DIR}" >&2; exit 1; }
  fi
  printf '%s\n' "  using source trees already embedded in the image"
else
  if [ "${FLAVOR}" = "standalone" ]; then
    clone_pinned "${TATER_URL}" "${TATER_REVISION}" "${TATER_APP_DIR}"
  fi
  clone_pinned "${SATELLITE_URL}" "${SATELLITE_REVISION}" "${SATELLITE_APP_DIR}"
fi

if [ "${FLAVOR}" = "standalone" ]; then
  section "Tater remote-only edge environment"
  if [ "${DRY_RUN}" = "1" ]; then
    printf '  + cd %s\n' "${TATER_APP_DIR}"
    run env \
      "TATER_VENV_DIR=${TATER_VENV_DIR}" \
      "TATER_RUNTIME_DIR=${STATE_DIR}/tater-runtime" \
      "TATER_AGENT_ROOT=${STATE_DIR}/agent-lab" \
      TATER_SETUP_INSTALL_SYSTEM_DEPS=0 \
      TATER_SETUP_LLAMA_CPP_NATIVE=0 \
      TATER_SETUP_REQUIRE_LOCAL_LLM=0 \
      sh setup_tater.sh edge
  else
    (
      cd "${TATER_APP_DIR}"
      env \
        TATER_VENV_DIR="${TATER_VENV_DIR}" \
        TATER_RUNTIME_DIR="${STATE_DIR}/tater-runtime" \
        TATER_AGENT_ROOT="${STATE_DIR}/agent-lab" \
        TATER_SETUP_INSTALL_SYSTEM_DEPS=0 \
        TATER_SETUP_LLAMA_CPP_NATIVE=0 \
        TATER_SETUP_REQUIRE_LOCAL_LLM=0 \
        sh setup_tater.sh edge
    )
  fi
fi

section "Satellite and appliance launcher environment"
run "${PYTHON_BIN}" -m venv "${APPLIANCE_VENV_DIR}"
run "${APPLIANCE_VENV_DIR}/bin/python" -m pip install --upgrade pip setuptools wheel
# Editable installation keeps the satellite's bundled wake-word and sound
# assets adjacent to its Python package.
run "${APPLIANCE_VENV_DIR}/bin/python" -m pip install --editable "${SATELLITE_APP_DIR}"
run "${APPLIANCE_VENV_DIR}/bin/python" -m pip install "${PROJECT_DIR}"

section "Configuration and systemd units"
if [ "${DRY_RUN}" = "1" ] || [ ! -e "${CONFIG_PATH}" ]; then
  if [ "${FLAVOR}" = "standalone" ]; then
    CONFIG_TEMPLATE="${PROJECT_DIR}/config/config.toml.example"
  else
    CONFIG_TEMPLATE="${PROJECT_DIR}/config/config.satellite.toml.example"
  fi
  run install -m 0644 "${CONFIG_TEMPLATE}" "${CONFIG_PATH}"
else
  printf '  preserving existing configuration: %s\n' "${CONFIG_PATH}"
fi
run install -m 0644 "${PROJECT_DIR}/systemd/tater-sat1-audio.service" "${SYSTEMD_DIR}/tater-sat1-audio.service"
run install -m 0644 "${PROJECT_DIR}/systemd/tater-sat1-firstboot.service" "${SYSTEMD_DIR}/tater-sat1-firstboot.service"
run install -m 0755 "${PROJECT_DIR}/script/firstboot" "/usr/local/sbin/tater-sat1-firstboot"
if [ "${FLAVOR}" = "standalone" ]; then
  run install -m 0644 "${PROJECT_DIR}/systemd/tater-sat1-tater.service" "${SYSTEMD_DIR}/tater-sat1-tater.service"
  run install -m 0644 "${PROJECT_DIR}/systemd/tater-sat1-voice.service" "${SYSTEMD_DIR}/tater-sat1-voice.service"
else
  run install -m 0644 "${PROJECT_DIR}/systemd/tater-sat1-satellite.service" "${SYSTEMD_DIR}/tater-sat1-satellite.service"
  run install -m 0755 "${PROJECT_DIR}/script/pair" "/usr/local/bin/tater-sat1-pair"
fi
run chown -R "${SERVICE_USER}:${SERVICE_USER}" "${STATE_DIR}"
if [ "${DEFER_INIT}" = "1" ]; then
  printf '%s\n' "  deferring unique token creation until first boot"
else
  run runuser -u "${SERVICE_USER}" -- "${APPLIANCE_VENV_DIR}/bin/tater-sat1-standalone" --config "${CONFIG_PATH}" init
fi
run runuser -u "${SERVICE_USER}" -- "${APPLIANCE_VENV_DIR}/bin/tater-sat1-standalone" --config "${CONFIG_PATH}" doctor

if [ "${ENABLE_SERVICES}" = "1" ]; then
  section "Enable appliance"
  run systemctl daemon-reload
  if [ "${FLAVOR}" = "standalone" ]; then
    run systemctl enable --now tater-sat1-firstboot.service tater-sat1-audio.service tater-sat1-tater.service tater-sat1-voice.service
  else
    run systemctl enable --now tater-sat1-firstboot.service tater-sat1-audio.service tater-sat1-satellite.service
  fi
else
  printf '\n%s\n' "Services installed but not enabled (--no-enable)."
fi

printf '\nSAT1 %s installation complete.\n' "${FLAVOR}"
if [ "${FLAVOR}" = "standalone" ]; then
  printf 'Tater UI: http://<pi-address>:%s\n' "8501"
else
  printf '%s\n' "Pair with: sudo tater-sat1-pair --url http://<tater-address>:8501 PAIRING_CODE"
fi
printf 'Configuration: %s\n' "${CONFIG_PATH}"
