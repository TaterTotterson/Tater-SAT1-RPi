[runtime]
flavor = "standalone"
state_dir = "/var/lib/tater-sat1-standalone"
tater_app_dir = "/opt/tater/app"
tater_python = "/opt/tater/venv/bin/python"
satellite_executable = "/opt/tater-sat1/venv/bin/tater-sat1-voice"

[tater]
host = "0.0.0.0"
port = 8501
# Leave blank to connect the local satellite over loopback.
url = ""
extra_args = []

[leds]
# The production 24-pixel ring is owned by the SAT1 XMOS controller and is
# reached over the Pi's SPI link. GPIO output remains available as a manual
# fallback for experimental HAT revisions.
enabled = true
backend = "xmos"
pixel_count = 24
spi_bus = 0
spi_device = 0
spi_speed_hz = 1000000
gpio_pin = 12
frequency_hz = 800000
dma_channel = 10
channel = 0
invert = false
brightness = 0.66
red = 0.094
green = 0.733
blue = 0.949
peripheral_host = "127.0.0.1"
peripheral_port = 6055
# The sink monitor supplies real reply-audio level for the reactive voice ring.
playback_monitor = "satellite1_output.monitor"

[satellite]
name = "auto"
device_id = "auto"
board = "satellite1_rpi_standalone"
room = ""

# Stable names created by the appliance's private PulseAudio graph.
audio_input_device = "satellite1_input"
audio_output_device = "pulse/satellite1_output"
# Private PulseAudio socket managed by tater-sat1-audio.service.
pulse_server = "unix:/run/tater-sat1-audio/pulse/native"
# The bundled Linux Satellite source includes okay_nabu. Point this at a
# downloaded Tater wake-word model once one is installed in the models folder.
wake_model = "okay_nabu"
extra_args = []
