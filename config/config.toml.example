[runtime]
state_dir = "/var/lib/tater-sat1-standalone"
tater_app_dir = "/opt/tater/app"
tater_python = "/opt/tater/venv/bin/python"
satellite_executable = "/opt/tater-sat1/venv/bin/linux-voice-assistant"

[tater]
host = "0.0.0.0"
port = 8501
extra_args = []

[satellite]
name = "Tater SAT1"
device_id = "tater-sat1-standalone"
board = "satellite1_rpi"
room = ""

# Replace these after running linux-voice-assistant with --list-input-devices
# and --list-output-devices on the SAT1 Raspberry Pi image.
audio_input_device = "default"
audio_output_device = "default"
# Set this only if the appliance audio server is not discoverable by default.
pulse_server = ""
wake_model = "hey_tater"
extra_args = []

