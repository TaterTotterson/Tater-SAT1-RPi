[runtime]
flavor = "satellite"
state_dir = "/var/lib/tater-sat1-standalone"
tater_app_dir = "/opt/tater/app"
tater_python = "/opt/tater/venv/bin/python"
satellite_executable = "/opt/tater-sat1/venv/bin/tater-sat1-voice"

[tater]
# This can be changed while pairing with `sudo tater-sat1-pair --url ... CODE`.
url = "http://tater.local:8501"
host = "0.0.0.0"
port = 8501
extra_args = []

[leds]
# The Raspberry Pi HAT reference routes the ring through PWM GPIO 12. The
# animation layout follows the production SAT1 ESP32 firmware's 24-pixel GRB
# ring. These values can be changed without rebuilding the image.
enabled = true
pixel_count = 24
gpio_pin = 12
frequency_hz = 800000
dma_channel = 10
channel = 0
invert = false
brightness = 0.66
red = 0.094
green = 0.733
blue = 0.949
peripheral_host = "127.0.0.1"
peripheral_port = 6055

[satellite]
# "auto" derives a stable identity from the Raspberry Pi serial number.
name = "auto"
device_id = "auto"
board = "satellite1_rpi_satellite"
room = ""
audio_input_device = "default"
audio_output_device = "default"
pulse_server = "unix:/run/tater-sat1-audio/pulse/native"
wake_model = "okay_nabu"
extra_args = []
