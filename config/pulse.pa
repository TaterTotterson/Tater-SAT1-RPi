# Minimal private PulseAudio graph for the Satellite1 HAT. The kernel's
# simple-card profile exposes only playback through PulseAudio's automatic
# udev profile, even though ALSA also provides the capture device. Load both
# directions explicitly so Linux Voice Assistant sees stable device IDs.
.fail
load-module module-native-protocol-unix
load-module module-alsa-sink sink_name=satellite1_output device=satellite1_playback rate=48000 channels=2 tsched=0
load-module module-alsa-source source_name=satellite1_input device=satellite1_capture rate=48000 channels=2 mmap=0 tsched=0
# The SAT1 XMOS capture stream occupies substantially less than PulseAudio's
# nominal S32 full scale. Normalize it here so wake detection receives the same
# useful speech range as the ESP32 firmware while retaining clipping headroom.
# Pulse's startup-command parser uses the native 65,536 = 100% scale.
set-source-volume satellite1_input 131072
set-default-sink satellite1_output
set-default-source satellite1_input
