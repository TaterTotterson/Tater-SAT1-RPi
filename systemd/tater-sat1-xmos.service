[Unit]
Description=Verify the Satellite1 four-microphone XMOS firmware
After=local-fs.target systemd-modules-load.service
Before=tater-sat1-audio.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/opt/tater-sat1/script/hardware-setup
ExecStart=/opt/tater-sat1/venv/bin/tater-sat1-xmos-firmware --once-marker /run/tater-sat1-xmos-verified.json
TimeoutStartSec=15min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
