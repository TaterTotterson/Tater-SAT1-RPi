[Unit]
Description=Initialize unique state for the standalone Satellite1 appliance
Before=tater-sat1-tater.service tater-sat1-voice.service tater-sat1-satellite.service
ConditionPathExists=!/var/lib/tater-sat1-standalone/first-boot-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tater-sat1-firstboot

[Install]
WantedBy=multi-user.target
