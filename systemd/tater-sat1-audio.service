[Unit]
Description=PulseAudio server for the standalone Satellite1 appliance
Wants=sound.target satellite1-init.service
After=sound.target satellite1-init.service

[Service]
Type=simple
User=tater
Group=tater
SupplementaryGroups=audio
Environment=HOME=/var/lib/tater-sat1-standalone
Environment=XDG_RUNTIME_DIR=/run/tater-sat1-audio
Environment=PULSE_SERVER=unix:/run/tater-sat1-audio/pulse/native
Environment=PULSE_CLIENTCONFIG=/etc/tater-sat1-standalone/pulse-client.conf
RuntimeDirectory=tater-sat1-audio
RuntimeDirectoryMode=0700
# This root-only fallback keeps OTA from v0.1.5 safe: that updater knows how
# to replace this audio unit and /opt/tater-sat1, but not the new XMOS unit.
# A per-boot marker makes later audio restarts avoid touching the shared SPI bus.
ExecStartPre=+/opt/tater-sat1/venv/bin/tater-sat1-xmos-firmware --once-marker /run/tater-sat1-xmos-verified.json
ExecStartPre=/usr/local/sbin/tater-sat1-audio-hardware
ExecStart=/usr/bin/pulseaudio --daemonize=no --exit-idle-time=-1 --log-target=journal -n --file=/etc/tater-sat1-standalone/pulse.pa
ExecStartPost=/usr/local/sbin/tater-sat1-wait-audio
Restart=on-failure
RestartSec=2
TimeoutStartSec=15min
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
