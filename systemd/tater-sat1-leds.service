[Unit]
Description=Satellite1 24-pixel Tater LED animations
Wants=tater-sat1-audio.service
After=local-fs.target tater-sat1-audio.service
Before=tater-sat1-voice.service tater-sat1-satellite.service

[Service]
Type=simple
# The production backend talks to the SAT1 XMOS controller through /dev/spidev0.0.
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tater-sat1/venv/bin/tater-sat1-leds --config /etc/tater-sat1-standalone/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
